#!/usr/bin/env python3
from __future__ import annotations

import argparse
import gzip
import hashlib
import json
import stat
import tarfile
import tempfile
from pathlib import Path

from jsonschema import Draft202012Validator
from release_manifest import load_manifest

COMMON_PAYLOAD_FILES = (
    "README.md",
    "requirements-tooling.txt",
    "delivery/README.md",
    "delivery/apply-release",
    "delivery/generate-auth-secret",
    "delivery/install-auth-secret",
    "delivery/release_verifier.py",
    "delivery/retire-auth-secret",
    "delivery/validate-auth-secrets",
    "delivery/validate-environment",
    "delivery/verify-release",
    "release/manifest.schema.json",
    "release/package.schema.json",
    "release/release_manifest.py",
    "release/validate-manifest",
)
MODE_PAYLOAD_FILES = {
    "online": (
        "delivery/online/README.md",
        "delivery/online/fetch-release",
    ),
    "offline": (
        "delivery/offline/README.md",
        "delivery/offline/import-bundle",
    ),
}
EXECUTABLE_PAYLOAD_FILES = {
    "delivery/apply-release",
    "delivery/generate-auth-secret",
    "delivery/install-auth-secret",
    "delivery/retire-auth-secret",
    "delivery/validate-auth-secrets",
    "delivery/validate-environment",
    "delivery/verify-release",
    "delivery/online/fetch-release",
    "delivery/offline/import-bundle",
    "pki/ensure-server-certificate",
    "pki/validate-ca-state",
    "pki/verify-server-certificate",
    "release/validate-manifest",
}


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description="Build integrated deployment release assets."
    )
    parser.add_argument("--version", required=True)
    parser.add_argument("--manifest", required=True, type=Path)
    parser.add_argument("--edge-image-archive", required=True, type=Path)
    parser.add_argument("--server-image-archive", required=True, type=Path)
    parser.add_argument("--output", required=True, type=Path)
    return parser.parse_args()


def require_regular_file(source: Path, destination: Path) -> tuple[Path, Path]:
    if source.is_symlink() or not source.exists():
        raise ValueError(f"payload source is missing or symbolic: {destination}")
    if not stat.S_ISREG(source.stat().st_mode):
        raise ValueError(f"payload source is not a regular file: {destination}")
    return source, destination


def tree_files(repository: Path, relative_root: Path) -> list[tuple[Path, Path]]:
    root = repository / relative_root
    if root.is_symlink() or not root.is_dir():
        raise ValueError(f"payload root is missing or symbolic: {relative_root}")

    files = []
    for source in sorted(root.rglob("*")):
        destination = source.relative_to(repository)
        if source.is_symlink():
            raise ValueError(f"payload source is symbolic: {destination}")
        if source.is_dir():
            continue
        files.append(require_regular_file(source, destination))
    return files


def payload_files(
    repository: Path,
    target: str,
    mode: str,
    manifest: dict[str, object],
) -> list[tuple[Path, Path]]:
    relative_files = {
        Path(path) for path in [*COMMON_PAYLOAD_FILES, *MODE_PAYLOAD_FILES[mode]]
    }
    relative_files.add(Path("notices/README.md"))
    for target_manifest in manifest["targets"].values():
        for component in target_manifest["components"]:
            relative_files.update(Path(path) for path in component["notices"])

    files = [
        require_regular_file(repository / path, path) for path in sorted(relative_files)
    ]
    files.extend(tree_files(repository, Path("docs")))
    files.extend(tree_files(repository, Path("targets") / target))
    if target == "server":
        files.extend(tree_files(repository, Path("pki")))

    destinations = [destination for _, destination in files]
    if len(destinations) != len(set(destinations)):
        raise ValueError("payload allowlist contains duplicate destinations")
    return sorted(files, key=lambda item: item[1].as_posix())


def normalize_tar_info(info: tarfile.TarInfo) -> tarfile.TarInfo:
    info.uid = 0
    info.gid = 0
    info.uname = "root"
    info.gname = "root"
    info.mtime = 0
    info.pax_headers = {}
    return info


def add_file(archive: tarfile.TarFile, source: Path, destination: Path) -> None:
    info = normalize_tar_info(
        archive.gettarinfo(str(source), arcname=destination.as_posix())
    )
    info.mode = 0o755 if destination.as_posix() in EXECUTABLE_PAYLOAD_FILES else 0o644
    with source.open("rb") as source_file:
        archive.addfile(info, source_file)


def add_bytes(archive: tarfile.TarFile, content: bytes, destination: str) -> None:
    info = tarfile.TarInfo(destination)
    info.size = len(content)
    info.mode = 0o644
    normalize_tar_info(info)
    from io import BytesIO

    archive.addfile(info, BytesIO(content))


def build_package(
    output: Path,
    repository: Path,
    target: str,
    mode: str,
    manifest: dict[str, object],
    package_schema: dict[str, object],
    manifest_bytes: bytes,
    image_archive: Path | None,
) -> None:
    manifest_digest = hashlib.sha256(manifest_bytes).hexdigest()
    package = {
        "schemaVersion": 1,
        "version": manifest["version"],
        "target": target,
        "mode": mode,
        "platform": manifest["targets"][target]["platform"],
        "manifestSha256": manifest_digest,
    }
    if image_archive is not None:
        package["imageArchive"] = f"images/{target}-images.tar"
    Draft202012Validator(package_schema).validate(package)
    package_bytes = (
        json.dumps(package, ensure_ascii=False, indent=2, sort_keys=True) + "\n"
    ).encode()

    with (
        output.open("wb") as raw_output,
        gzip.GzipFile(
            filename="", mode="wb", fileobj=raw_output, mtime=0
        ) as compressed,
        tarfile.open(
            fileobj=compressed, mode="w", format=tarfile.PAX_FORMAT
        ) as archive,
    ):
        add_bytes(archive, package_bytes, "release-package.json")
        add_bytes(archive, manifest_bytes, "release-manifest.json")
        for source, destination in payload_files(repository, target, mode, manifest):
            add_file(archive, source, destination)
        if image_archive is not None:
            add_file(
                archive,
                image_archive,
                Path("images") / f"{target}-images.tar",
            )


def sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as source:
        for chunk in iter(lambda: source.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


def build_assets(args: argparse.Namespace) -> list[Path]:
    repository = Path(__file__).resolve().parents[1]
    manifest = load_manifest(
        repository,
        args.manifest.resolve(),
        args.version,
        require_components=True,
    )
    package_schema = json.loads(
        (repository / "release" / "package.schema.json").read_text(encoding="utf-8")
    )
    Draft202012Validator.check_schema(package_schema)
    image_archive_inputs = {
        "edge": args.edge_image_archive,
        "server": args.server_image_archive,
    }
    for target, image_archive in image_archive_inputs.items():
        if image_archive.is_symlink() or not image_archive.is_file():
            raise FileNotFoundError(
                f"{target} image archive not found: {image_archive}"
            )
    image_archives = {
        target: image_archive.resolve()
        for target, image_archive in image_archive_inputs.items()
    }

    output_directory = args.output.resolve()
    output_directory.mkdir(parents=True, exist_ok=True)
    names = {
        "edge-online": f"scrap-monitoring-edge-{args.version}-online.tar.gz",
        "server-online": f"scrap-monitoring-server-{args.version}-online.tar.gz",
        "edge-offline": f"scrap-monitoring-edge-{args.version}-offline.tar.gz",
        "server-offline": f"scrap-monitoring-server-{args.version}-offline.tar.gz",
    }
    reserved = [output_directory / name for name in names.values()]
    reserved.append(output_directory / "SHA256SUMS")
    existing = [path for path in reserved if path.exists()]
    if existing:
        raise FileExistsError(f"release output already exists: {existing[0]}")

    manifest_bytes = (
        json.dumps(manifest, ensure_ascii=False, indent=2, sort_keys=True) + "\n"
    ).encode()
    with tempfile.TemporaryDirectory(
        prefix="release-", dir=output_directory
    ) as temporary:
        temporary_directory = Path(temporary)
        build_package(
            temporary_directory / names["edge-online"],
            repository,
            "edge",
            "online",
            manifest,
            package_schema,
            manifest_bytes,
            None,
        )
        build_package(
            temporary_directory / names["server-online"],
            repository,
            "server",
            "online",
            manifest,
            package_schema,
            manifest_bytes,
            None,
        )
        build_package(
            temporary_directory / names["edge-offline"],
            repository,
            "edge",
            "offline",
            manifest,
            package_schema,
            manifest_bytes,
            image_archives["edge"],
        )
        build_package(
            temporary_directory / names["server-offline"],
            repository,
            "server",
            "offline",
            manifest,
            package_schema,
            manifest_bytes,
            image_archives["server"],
        )

        assets = [temporary_directory / name for name in names.values()]
        checksum_path = temporary_directory / "SHA256SUMS"
        checksum_path.write_text(
            "".join(f"{sha256(asset)}  {asset.name}\n" for asset in assets),
            encoding="utf-8",
        )
        for asset in [*assets, checksum_path]:
            asset.replace(output_directory / asset.name)

    return [output_directory / name for name in [*names.values(), "SHA256SUMS"]]


def main() -> None:
    for asset in build_assets(parse_args()):
        print(asset)


if __name__ == "__main__":
    main()
