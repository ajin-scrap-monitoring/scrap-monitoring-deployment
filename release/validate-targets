#!/usr/bin/env python3
from __future__ import annotations

import argparse
from pathlib import Path

from release_manifest import load_manifest
from target_validation import validate_targets


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description="Validate release manifest and target Compose integration."
    )
    parser.add_argument("--version", required=True)
    parser.add_argument("--manifest", required=True, type=Path)
    return parser.parse_args()


def main() -> None:
    args = parse_args()
    repository = Path(__file__).resolve().parents[1]
    manifest = load_manifest(
        repository,
        args.manifest.resolve(),
        args.version,
        require_components=True,
    )
    validate_targets(repository, manifest)


if __name__ == "__main__":
    main()
