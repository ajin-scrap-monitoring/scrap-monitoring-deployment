[Unit]
Description=Scrap Monitoring Server
Wants=network-online.target
Requires=docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
EnvironmentFile=/etc/scrap-monitoring/server.env
EnvironmentFile=/srv/scrap-monitoring/deployment/current/targets/server/release.env
ExecStartPre=/usr/bin/env /srv/scrap-monitoring/deployment/current/delivery/validate-environment server /etc/scrap-monitoring/server.env
ExecStart=/usr/bin/env docker compose --project-directory /srv/scrap-monitoring/deployment/current/targets/server up --detach --remove-orphans
ExecStop=/usr/bin/env docker compose --project-directory /srv/scrap-monitoring/deployment/current/targets/server down
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
