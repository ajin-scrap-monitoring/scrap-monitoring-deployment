# This file defines the public schema for a simulation Edge environment.
ENVIRONMENT_SCHEMA_VERSION=2
# DEPLOYMENT_SCENARIO selects the simulation target composition.
DEPLOYMENT_SCENARIO=simulation
# SITE_ID identifies the synthetic monitoring site.
SITE_ID=simulation-site
# EDGE_ID identifies the synthetic Edge device.
EDGE_ID=simulation-edge
# CONFIG_REVISION must match the synthetic Edge component configuration.
CONFIG_REVISION=simulation-config-r1
# CAMERA_ID identifies the synthetic camera connected to this Edge device.
CAMERA_ID=simulation-camera
# RUNTIME_DIR contains sockets, status files, the outbox and generated runtime state.
RUNTIME_DIR=/opt/ajin/runtime
# CONFIG_FILE points to the complete approved synthetic Edge configuration.
CONFIG_FILE=/opt/ajin/config/edge-simulation.json
# SIMULATOR_CONFIG_DIR contains the public simulator JSON inputs.
SIMULATOR_CONFIG_DIR=/opt/ajin/config/lidar-simulator
# SIMULATOR_RUNTIME_ENV_FILE contains the simulator runtime environment.
SIMULATOR_RUNTIME_ENV_FILE=/etc/scrap-monitoring/lidar-simulator.env
# SIMULATOR_OBSERVATION_HOST identifies the restricted Visualizer TCP listener.
SIMULATOR_OBSERVATION_HOST=visualizer.example.invalid
# SIMULATOR_OBSERVATION_PORT identifies the restricted Visualizer TCP listener port.
SIMULATOR_OBSERVATION_PORT=17000
# SYNTHETIC_CAMERA_BRIDGE_URL identifies the Visualizer MJPEG WebSocket stream.
SYNTHETIC_CAMERA_BRIDGE_URL=ws://visualizer.example.invalid:18000/camera/v1/stream
# SYNTHETIC_CAMERA_DEVICE identifies the dedicated Video4Linux loopback device.
SYNTHETIC_CAMERA_DEVICE=/dev/scrap-synthetic-camera
# MEASUREMENT_URL receives the Edge measurement contract over HTTPS.
MEASUREMENT_URL=https://monitoring.example.invalid/api/v1/metrics/ingest
# HEARTBEAT_URL receives the Edge heartbeat contract over HTTPS.
HEARTBEAT_URL=https://monitoring.example.invalid/api/v1/edge/heartbeat
# MEDIA_WSS_URL receives authenticated binary JPEG frames over WSS.
MEDIA_WSS_URL=wss://monitoring.example.invalid/api/v1/cameras/simulation-camera/stream
# EDGE_TOKEN_FILE points to the Backend Bearer token file.
EDGE_TOKEN_FILE=/opt/ajin/secrets/edge-token
# CAMERA_TOKEN_FILE points to the Camera Media Service Bearer token file.
CAMERA_TOKEN_FILE=/opt/ajin/secrets/camera-token
# EDGE_ROOT_CA_FILE points to the Root CA already installed on the Edge host.
EDGE_ROOT_CA_FILE=/usr/local/share/ca-certificates/scrap-monitoring-root-ca.crt
# VIDEO_GID identifies the host video group passed to the camera containers.
VIDEO_GID=44
