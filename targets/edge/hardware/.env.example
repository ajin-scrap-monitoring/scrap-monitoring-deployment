# This file defines the public schema for a hardware Edge environment.
ENVIRONMENT_SCHEMA_VERSION=4
# DEPLOYMENT_SCENARIO selects the hardware target composition.
DEPLOYMENT_SCENARIO=hardware
# SITE_ID identifies the monitoring site.
SITE_ID=example-site
# EDGE_ID identifies the Edge device.
EDGE_ID=example-edge
# CONFIG_REVISION must match the revision in the Edge component configuration.
CONFIG_REVISION=example-config-r1
# CAMERA_ID identifies the camera connected to this Edge device.
CAMERA_ID=example-camera
# RUNTIME_DIR contains sockets, status files, the outbox and generated runtime state.
RUNTIME_DIR=/opt/ajin/runtime/v2
# CONFIG_FILE points to the approved Edge component configuration.
CONFIG_FILE=/opt/ajin/config/edge-v2.runtime.json
# LIDAR_A_IP identifies the first LiDAR on the site network.
LIDAR_A_IP=198.51.100.21
# LIDAR_B_IP identifies the second LiDAR on the site network.
LIDAR_B_IP=198.51.100.22
# BACKEND_ORIGIN supplies the HTTPS origin for all four Edge v2 ingest routes.
BACKEND_ORIGIN=https://monitoring.example.invalid
# MEDIA_WSS_URL receives authenticated binary JPEG frames over WSS.
MEDIA_WSS_URL=wss://monitoring.example.invalid/api/v1/cameras/example-camera/stream
# EDGE_TOKEN_FILE points to the Backend Bearer token file.
EDGE_TOKEN_FILE=/opt/ajin/secrets/edge-token
# CAMERA_TOKEN_FILE points to the Camera Media Service Bearer token file.
CAMERA_TOKEN_FILE=/opt/ajin/secrets/camera-token
# EDGE_ROOT_CA_FILE points to the Root CA already installed on the Edge host.
EDGE_ROOT_CA_FILE=/usr/local/share/ca-certificates/scrap-monitoring-root-ca.crt
# CAMERA_DEVICE identifies the Video4Linux camera device.
CAMERA_DEVICE=/dev/video0
# VIDEO_GID is set from the host video group by the deployment applier.
VIDEO_GID=44
