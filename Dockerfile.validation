FROM docker:29.8.0-cli AS docker_cli

FROM node:24.21.0-bookworm-slim AS node

FROM golang:1.27.1-bookworm AS go

FROM ghcr.io/astral-sh/uv:0.12.15 AS uv

FROM debian:bookworm-slim AS validation

RUN apt-get update \
    && apt-get install --yes --no-install-recommends \
    bash \
    ca-certificates \
    coreutils \
    git \
    jq \
    openssl \
    python3 \
    shellcheck \
    systemd \
    && rm -rf /var/lib/apt/lists/*

COPY --from=docker_cli /usr/local/bin/docker /usr/local/bin/docker
COPY --from=docker_cli /usr/local/libexec/docker/cli-plugins/docker-compose /usr/local/libexec/docker/cli-plugins/docker-compose
COPY --from=node /usr/local /usr/local
COPY --from=go /usr/local/go /usr/local/go
COPY --from=uv /uv /usr/local/bin/uv

ENV PATH=/usr/local/go/bin:${PATH}

WORKDIR /workspace

COPY . .

RUN tools/install-validation

CMD ["tests/validate-repository"]
