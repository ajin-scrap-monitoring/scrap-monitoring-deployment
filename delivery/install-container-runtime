#!/usr/bin/env bash
set -euo pipefail

usage() {
  printf '%s\n' 'Usage: install-container-runtime --target <edge|server>'
}

target=""
while [[ "$#" -gt 0 ]]; do
  case "$1" in
    --help)
      usage
      exit 0
      ;;
    --target)
      [[ "$#" -ge 2 ]] || { usage >&2; exit 2; }
      target="$2"
      shift 2
      ;;
    *)
      usage >&2
      exit 2
      ;;
  esac
done
if [[ "${target}" != "edge" && "${target}" != "server" ]]; then
  usage >&2
  exit 2
fi
if [[ "${EUID}" -ne 0 ]]; then
  printf '%s\n' 'container runtime installation requires root privileges' >&2
  exit 1
fi

# shellcheck disable=SC1091
. /etc/os-release
case "${ID}" in
  debian|ubuntu) ;;
  *)
    printf '%s\n' "unsupported operating system: ${ID}" >&2
    exit 1
    ;;
esac

architecture="$(dpkg --print-architecture)"
if [[ "${target}" == "edge" && "${architecture}" != "arm64" ]]; then
  printf '%s\n' "Edge host architecture must be arm64: ${architecture}" >&2
  exit 1
fi
if [[ "${target}" == "server" && "${architecture}" != "amd64" ]]; then
  printf '%s\n' "Server host architecture must be amd64: ${architecture}" >&2
  exit 1
fi

script_directory="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=delivery/runtime-requirements.sh
. "${script_directory}/runtime-requirements.sh"

if ! command -v systemctl >/dev/null || ! systemctl show --property Version --value >/dev/null; then
  printf '%s\n' 'an active systemd host is required' >&2
  exit 1
fi

docker_source="$(runtime_apt_source_state /etc/apt \
  "https://download.docker.com/linux/${ID}" "${VERSION_CODENAME}" stable "${architecture}")"
smallstep_source=present
if [[ "${target}" == "server" ]]; then
  smallstep_source="$(runtime_apt_source_state /etc/apt \
    https://packages.smallstep.com/stable/debian debs main "${architecture}")"
fi
if [[ "${docker_source}" == absent && ( -e /etc/apt/sources.list.d/docker.list || -L /etc/apt/sources.list.d/docker.list ) ]] \
  || [[ "${smallstep_source}" == absent && ( -e /etc/apt/sources.list.d/smallstep.sources || -L /etc/apt/sources.list.d/smallstep.sources ) ]]; then
  printf '%s\n' 'reserved APT source file already exists; existing configuration preserved' >&2
  exit 1
fi

apt-get update
apt-get install --yes \
  bash \
  ca-certificates \
  coreutils \
  curl \
  findutils \
  gnupg \
  jq \
  openssl \
  passwd \
  python3 \
  util-linux
validate_host_tools
if ! getent group scrap-admin >/dev/null; then
  groupadd --system scrap-admin
fi
install -d -m 0755 /etc/apt/keyrings
if [[ "${docker_source}" == absent ]]; then
  curl -fsSL "https://download.docker.com/linux/${ID}/gpg" \
    | gpg --dearmor --yes -o /etc/apt/keyrings/docker.gpg
  chmod 0644 /etc/apt/keyrings/docker.gpg
  printf '%s\n' \
    "deb [arch=${architecture} signed-by=/etc/apt/keyrings/docker.gpg] https://download.docker.com/linux/${ID} ${VERSION_CODENAME} stable" \
    > /etc/apt/sources.list.d/docker.list
fi

if [[ "${target}" == "server" && "${smallstep_source}" == absent ]]; then
  curl -fsSL https://packages.smallstep.com/keys/apt/repo-signing-key.gpg \
    -o /etc/apt/keyrings/smallstep.asc
  chmod 0644 /etc/apt/keyrings/smallstep.asc
  printf '%s\n' \
    'Types: deb' \
    'URIs: https://packages.smallstep.com/stable/debian' \
    'Suites: debs' \
    'Components: main' \
    'Signed-By: /etc/apt/keyrings/smallstep.asc' \
    > /etc/apt/sources.list.d/smallstep.sources
fi

apt-get update
docker_ce_version="$(package_version docker-ce '5:29.8.0')"
docker_cli_version="$(package_version docker-ce-cli '5:29.8.0')"
containerd_version="$(package_version containerd.io '2.3.5')"
compose_version="$(package_version docker-compose-plugin '5.5.1')"
packages=(
  "containerd.io=${containerd_version}" \
  "docker-ce=${docker_ce_version}" \
  "docker-ce-cli=${docker_cli_version}" \
  "docker-compose-plugin=${compose_version}"
)
if [[ "${target}" == "server" ]]; then
  step_cli_version="$(package_version step-cli '0.30.6')"
  step_ca_version="$(package_version step-ca '0.30.2')"
  packages+=(
    "step-cli=${step_cli_version}" \
    "step-ca=${step_ca_version}"
  )
fi
apt-get install --yes --no-install-recommends "${packages[@]}"
systemctl enable --now docker

require_exact_version 'Docker Engine' "$(docker version --format '{{.Server.Version}}')" '29.8.0'
require_exact_version 'Docker CLI' "$(docker version --format '{{.Client.Version}}')" '29.8.0'
require_exact_version 'Docker Compose plugin' "$(docker compose version --short)" '5.5.1'
containerd_actual="$(containerd --version | awk '{ sub(/^v/, "", $3); print $3 }')"
require_exact_version containerd "${containerd_actual}" '2.3.5'
if [[ "${target}" == "server" ]]; then
  step_actual="$(step version | awk -F/ 'NR == 1 { split($2, fields, /[[:space:]]/); print fields[1] }')"
  step_ca_actual="$(step-ca version | awk -F/ 'NR == 1 { split($2, fields, /[[:space:]]/); print fields[1] }')"
  require_exact_version 'step CLI' "${step_actual}" '0.30.6'
  require_exact_version step-ca "${step_ca_actual}" '0.30.2'
fi
