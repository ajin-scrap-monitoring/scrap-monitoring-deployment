#!/usr/bin/env bash
set -euo pipefail

usage() {
  printf '%s\n' 'Usage: generate-auth-secret <edge-backend|camera-media> <identity> <output-directory>'
}

if (( $# == 1 )) && [[ "$1" == "--help" ]]; then
  usage
  exit 0
fi

if (( $# != 3 )); then
  usage >&2
  exit 2
fi

kind=$1
identity=$2
output_directory=$3

case "$kind" in
  edge-backend|camera-media) ;;
  *)
    printf '%s\n' 'kind must be edge-backend or camera-media' >&2
    exit 2
    ;;
esac

if [[ ! "$identity" =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$ ]]; then
  printf '%s\n' 'identity must contain 1 to 64 letters, digits, dots, underscores or hyphens' >&2
  exit 2
fi

if [[ -e "$output_directory" ]]; then
  printf '%s\n' "output already exists: $output_directory" >&2
  exit 1
fi

output_parent=$(dirname "$output_directory")
output_name=$(basename "$output_directory")
if [[ ! -d "$output_parent" ]]; then
  printf '%s\n' "output parent is missing: $output_parent" >&2
  exit 1
fi

umask 077
temporary_directory=$(mktemp -d "$output_parent/.${output_name}.XXXXXX")
cleanup() {
  if [[ -d "$temporary_directory" ]]; then
    find "$temporary_directory" -depth -delete
  fi
}
trap cleanup EXIT

token_file="$temporary_directory/token"
od -An -N32 -tx1 /dev/urandom | tr -d ' \n' > "$token_file"

if ! grep -Eq '^[0-9a-f]{64}$' "$token_file"; then
  printf '%s\n' 'generated token has an invalid format' >&2
  exit 1
fi

digest=$(sha256sum "$token_file" | awk '{print $1}')
jq --null-input \
  --arg kind "$kind" \
  --arg identity "$identity" \
  --arg digest "$digest" \
  '{schemaVersion: 1, kind: $kind, identity: $identity, digest: $digest}' \
  > "$temporary_directory/metadata.json"
chmod 0600 "$token_file" "$temporary_directory/metadata.json"

mv "$temporary_directory" "$output_directory"
trap - EXIT
printf '%s\n' "credential bundle created: $output_directory"
