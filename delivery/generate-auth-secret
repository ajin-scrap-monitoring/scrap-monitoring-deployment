#!/usr/bin/env bash
set -euo pipefail

usage() {
  printf '%s\n' 'Usage: generate-auth-secret [--site-id <id> --sensor-id <id> --sensor-id <id>] <edge-backend|camera-media|edge-control> <identity> <output-directory>'
  printf '%s\n' 'edge-backend requires --site-id and two --sensor-id options; camera-media and edge-control accept none.'
}

site_id=''
sensor_ids=()
while (( $# > 0 )); do
  case "$1" in
    --help)
      usage
      exit 0
      ;;
    --site-id)
      (( $# >= 2 )) || { usage >&2; exit 2; }
      site_id=$2
      shift 2
      ;;
    --sensor-id)
      (( $# >= 2 )) || { usage >&2; exit 2; }
      sensor_ids+=("$2")
      shift 2
      ;;
    --*)
      usage >&2
      exit 2
      ;;
    *)
      break
      ;;
  esac
done

if (( $# != 3 )); then
  usage >&2
  exit 2
fi

kind=$1
identity=$2
output_directory=$3

case "$kind" in
  edge-backend|camera-media|edge-control) ;;
  *)
    printf '%s\n' 'kind must be edge-backend, camera-media or edge-control' >&2
    exit 2
    ;;
esac

id_pattern='^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$'
if [[ "$kind" == edge-backend ]]; then
  if [[ ! "$site_id" =~ $id_pattern ]] || (( ${#sensor_ids[@]} != 2 )) \
    || [[ ! "${sensor_ids[0]}" =~ $id_pattern || ! "${sensor_ids[1]}" =~ $id_pattern ]] \
    || [[ "${sensor_ids[0]}" == "${sensor_ids[1]}" ]]; then
    printf '%s\n' 'edge-backend requires --site-id and two distinct valid --sensor-id values' >&2
    exit 2
  fi
elif [[ -n "$site_id" ]] || (( ${#sensor_ids[@]} > 0 )); then
  printf '%s\n' 'camera-media and edge-control do not accept --site-id or --sensor-id' >&2
  exit 2
fi

if [[ ! "$identity" =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$ ]]; then
  printf '%s\n' 'identity must contain 1 to 64 letters, digits, dots, underscores or hyphens' >&2
  exit 2
fi

if [[ -e "$output_directory" ]]; then
  printf '%s\n' "output already exists: $output_directory" >&2
  exit 1
fi

output_parent=$(dirname "$output_directory")
output_name=$(basename "$output_directory")
if [[ ! -d "$output_parent" ]]; then
  printf '%s\n' "output parent is missing: $output_parent" >&2
  exit 1
fi

umask 077
temporary_directory=$(mktemp -d "$output_parent/.${output_name}.XXXXXX")
cleanup() {
  if [[ -d "$temporary_directory" ]]; then
    find "$temporary_directory" -depth -delete
  fi
}
trap cleanup EXIT

token_file="$temporary_directory/token"
od -An -N32 -tx1 /dev/urandom | tr -d ' \n' > "$token_file"

if ! grep -Eq '^[0-9a-f]{64}$' "$token_file"; then
  printf '%s\n' 'generated token has an invalid format' >&2
  exit 1
fi

digest=$(sha256sum "$token_file" | awk '{print $1}')
jq --null-input \
  --arg kind "$kind" \
  --arg identity "$identity" \
  --arg digest "$digest" \
  --arg site_id "$site_id" \
  --arg sensor_a "${sensor_ids[0]:-}" \
  --arg sensor_b "${sensor_ids[1]:-}" \
  '{schemaVersion: 1, kind: $kind, identity: $identity, digest: $digest}
   + (if $kind == "edge-backend"
      then {siteId: $site_id, sensorIds: [$sensor_a, $sensor_b]} else {} end)' \
  > "$temporary_directory/metadata.json"
chmod 0600 "$token_file" "$temporary_directory/metadata.json"

mv "$temporary_directory" "$output_directory"
trap - EXIT
printf '%s\n' "credential bundle created: $output_directory"
