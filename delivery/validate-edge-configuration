#!/usr/bin/env bash
set -euo pipefail

if [[ "${1:-}" == "--help" ]]; then
  printf '%s\n' 'Usage: validate-edge-configuration <environment-file> [--root <directory>]'
  exit 0
fi
if [[ "$#" != 1 && "$#" != 3 ]]; then
  printf '%s\n' 'Usage: validate-edge-configuration <environment-file> [--root <directory>]' >&2
  exit 2
fi
script_directory="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ ! -f "$1" ]]; then
  printf '%s\n' 'environment file is missing' >&2
  exit 1
fi
scenario=$(awk -F= '$1 == "DEPLOYMENT_SCENARIO" {print $2}' "$1")
"${script_directory}/validate-environment" edge "${scenario}" "$1" >/dev/null
exec python3 "${script_directory}/edge_configuration.py" "$@"
