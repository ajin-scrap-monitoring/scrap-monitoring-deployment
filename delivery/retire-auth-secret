#!/usr/bin/env bash
set -euo pipefail

script_directory="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=delivery/auth-secret-permissions.sh
source "$script_directory/auth-secret-permissions.sh"

usage() {
  printf '%s\n' 'Usage: retire-auth-secret [--root <directory>] <bundle-directory>'
}

root_directory=/
if [[ "${1:-}" == "--help" ]]; then
  usage
  exit 0
fi
if [[ "${1:-}" == "--root" ]]; then
  if (( $# < 3 )); then
    usage >&2
    exit 2
  fi
  root_directory=$2
  shift 2
fi
if (( $# != 1 )); then
  usage >&2
  exit 2
fi

bundle_directory=$1
root_directory=$(auth_root_directory "$root_directory")
auth_check_path "$bundle_directory"

token_file="$bundle_directory/token"
metadata_file="$bundle_directory/metadata.json"
auth_regular_file "$token_file"
auth_regular_file "$metadata_file"
if [[ ! -f "$token_file" || -L "$token_file" || ! -f "$metadata_file" || -L "$metadata_file" ]]; then
  printf '%s\n' 'credential bundle must contain token and metadata.json' >&2
  exit 1
fi
for private_path in "$bundle_directory" "$token_file" "$metadata_file"; do
  private_mode=$(stat --format='%a' "$private_path")
  if (( (8#$private_mode & 077) != 0 )); then
    printf '%s\n' "credential bundle grants group or other access: $private_path" >&2
    exit 1
  fi
done
if (( $(wc -c < "$token_file") != 64 )) || ! grep -Eq '^[0-9a-f]{64}$' "$token_file"; then
  printf '%s\n' 'credential token has an invalid format' >&2
  exit 1
fi
if ! jq --exit-status '
  .schemaVersion == 1 and
  (.kind == "edge-backend" or .kind == "camera-media") and
  (.identity | type == "string" and test("^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$")) and
  (.digest | type == "string" and test("^[0-9a-f]{64}$"))
' "$metadata_file" >/dev/null; then
  printf '%s\n' 'credential metadata is invalid' >&2
  exit 1
fi

kind=$(jq --raw-output '.kind' "$metadata_file")
identity=$(jq --raw-output '.identity' "$metadata_file")
expected_digest=$(jq --raw-output '.digest' "$metadata_file")
actual_digest=$(sha256sum "$token_file" | awk '{print $1}')
if [[ "$actual_digest" != "$expected_digest" ]]; then
  printf '%s\n' 'credential token does not match metadata digest' >&2
  exit 1
fi

case "$kind" in
  edge-backend) registry_relative=srv/scrap-monitoring/secrets/backend/edge-token-digests.json ;;
  camera-media) registry_relative=srv/scrap-monitoring/secrets/media/camera-token-digests.json ;;
esac
registry="$root_directory/$registry_relative"
registry_directory=$(dirname "$registry")
reader_group=$(auth_reader_group server "$kind")
reader_gid=$(auth_reader_gid "$root_directory" "$reader_group")
private_gid=$(auth_private_gid "$root_directory")
auth_regular_file "$registry"
if [[ ! -f "$registry" || -L "$registry" ]]; then
  printf '%s\n' "credential registry is missing or not a regular file: $registry" >&2
  exit 1
fi

auth_validate_permissions "$root_directory" "$registry_directory" 700 "$private_gid"
auth_validate_permissions "$root_directory" "$registry" 640 "$reader_gid"
umask 077
auth_lock "$root_directory" "$registry_directory/.auth-secret.lock"

if ! jq --exit-status '
  .schemaVersion == 1 and
  (.identities | type == "object") and
  all(.identities | to_entries[];
    (.key | test("^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$")) and
    (.value | type == "array" and length >= 1 and length <= 2) and
    all(.value[]; type == "string" and test("^[0-9a-f]{64}$")))
' "$registry" >/dev/null; then
  printf '%s\n' "installed credential registry is invalid: $registry" >&2
  exit 1
fi

if ! jq --exit-status --arg identity "$identity" --arg digest "$actual_digest" \
  '.identities[$identity] // [] | index($digest) != null' "$registry" >/dev/null; then
  printf '%s\n' "credential already retired: $kind/$identity"
  exit 0
fi

active_count=$(jq --arg identity "$identity" '.identities[$identity] // [] | length' "$registry")
if (( active_count <= 1 )); then
  printf '%s\n' "cannot retire the only active digest: $kind/$identity" >&2
  exit 1
fi

umask 077
temporary_registry=$(mktemp "$registry_directory/.registry.XXXXXX")
cleanup() {
  find "$temporary_registry" -maxdepth 0 -type f -delete
}
trap cleanup EXIT
jq --arg identity "$identity" --arg digest "$actual_digest" \
  '.identities[$identity] |= map(select(. != $digest))' \
  "$registry" > "$temporary_registry"
auth_set_permissions "$root_directory" "$temporary_registry" 640 "$reader_gid"
mv "$temporary_registry" "$registry"
trap - EXIT

printf '%s\n' "credential retired: $kind/$identity"
