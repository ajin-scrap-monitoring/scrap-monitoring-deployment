#!/usr/bin/env bash
set -euo pipefail

usage() {
  printf '%s\n' 'Usage: install-auth-secret [--root <directory>] [--rotate] <edge|server> <bundle-directory>'
}

root_directory=/
rotate=false
while (( $# > 0 )); do
  case "$1" in
    --help)
      usage
      exit 0
      ;;
    --root)
      if (( $# < 2 )); then
        usage >&2
        exit 2
      fi
      root_directory=$2
      shift 2
      ;;
    --rotate)
      rotate=true
      shift
      ;;
    --*)
      usage >&2
      exit 2
      ;;
    *)
      break
      ;;
  esac
done

if (( $# != 2 )); then
  usage >&2
  exit 2
fi

target=$1
bundle_directory=$2
case "$target" in
  edge|server) ;;
  *)
    printf '%s\n' 'target must be edge or server' >&2
    exit 2
    ;;
esac

if [[ "$root_directory" == "/" && "$EUID" -ne 0 ]]; then
  printf '%s\n' 'installing into the host root requires root' >&2
  exit 1
fi
if [[ ! -d "$root_directory" ]]; then
  printf '%s\n' "root directory is missing: $root_directory" >&2
  exit 1
fi

token_file="$bundle_directory/token"
metadata_file="$bundle_directory/metadata.json"
if [[ ! -f "$token_file" || -L "$token_file" || ! -f "$metadata_file" || -L "$metadata_file" ]]; then
  printf '%s\n' 'credential bundle must contain token and metadata.json' >&2
  exit 1
fi
for private_path in "$bundle_directory" "$token_file" "$metadata_file"; do
  private_mode=$(stat --format='%a' "$private_path")
  if (( (8#$private_mode & 077) != 0 )); then
    printf '%s\n' "credential bundle grants group or other access: $private_path" >&2
    exit 1
  fi
done
if (( $(wc -c < "$token_file") != 64 )) || ! grep -Eq '^[0-9a-f]{64}$' "$token_file"; then
  printf '%s\n' 'credential token has an invalid format' >&2
  exit 1
fi
if ! jq --exit-status '
  .schemaVersion == 1 and
  (.kind == "edge-backend" or .kind == "camera-media") and
  (.identity | type == "string" and test("^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$")) and
  (.digest | type == "string" and test("^[0-9a-f]{64}$"))
' "$metadata_file" >/dev/null; then
  printf '%s\n' 'credential metadata is invalid' >&2
  exit 1
fi

kind=$(jq --raw-output '.kind' "$metadata_file")
identity=$(jq --raw-output '.identity' "$metadata_file")
expected_digest=$(jq --raw-output '.digest' "$metadata_file")
actual_digest=$(sha256sum "$token_file" | awk '{print $1}')
if [[ "$actual_digest" != "$expected_digest" ]]; then
  printf '%s\n' 'credential token does not match metadata digest' >&2
  exit 1
fi

umask 077
if [[ "$target" == "edge" ]]; then
  secret_directory="$root_directory/opt/ajin/secrets"
  case "$kind" in
    edge-backend) destination_name=edge-token ;;
    camera-media) destination_name=camera-token ;;
  esac
  destination="$secret_directory/$destination_name"
  destination_metadata="$secret_directory/$destination_name.metadata.json"
  mkdir -p "$secret_directory"
  chmod 0700 "$secret_directory"

  if [[ -e "$destination" ]]; then
    if [[ -L "$destination" || ! -f "$destination" ]]; then
      printf '%s\n' "installed credential is not a regular file: $destination" >&2
      exit 1
    fi
    installed_digest=$(sha256sum "$destination" | awk '{print $1}')
    if [[ "$installed_digest" == "$actual_digest" ]]; then
      rotate=true
    elif [[ "$rotate" != true ]]; then
      printf '%s\n' "credential already exists; use --rotate: $destination" >&2
      exit 1
    fi
  fi

  temporary_token=$(mktemp "$secret_directory/.${destination_name}.XXXXXX")
  temporary_metadata=$(mktemp "$secret_directory/.${destination_name}.metadata.XXXXXX")
  cleanup_edge() {
    find "$temporary_token" "$temporary_metadata" -maxdepth 0 -type f -delete
  }
  trap cleanup_edge EXIT
  install -m 0600 "$token_file" "$temporary_token"
  install -m 0600 "$metadata_file" "$temporary_metadata"
  mv "$temporary_token" "$destination"
  mv "$temporary_metadata" "$destination_metadata"
  trap - EXIT
else
  case "$kind" in
    edge-backend) registry_relative=srv/scrap-monitoring/secrets/backend/edge-token-digests.json ;;
    camera-media) registry_relative=srv/scrap-monitoring/secrets/media/camera-token-digests.json ;;
  esac
  registry="$root_directory/$registry_relative"
  registry_directory=$(dirname "$registry")
  mkdir -p "$registry_directory"
  chmod 0700 "$registry_directory"

  lock_file="$registry_directory/.auth-secret.lock"
  exec 9>"$lock_file"
  chmod 0600 "$lock_file"
  flock --exclusive 9

  temporary_registry=$(mktemp "$registry_directory/.registry.XXXXXX")
  cleanup_server() {
    find "$temporary_registry" -maxdepth 0 -type f -delete
  }
  trap cleanup_server EXIT

  if [[ -f "$registry" ]]; then
    if [[ -L "$registry" ]]; then
      printf '%s\n' "installed credential registry is a symbolic link: $registry" >&2
      exit 1
    fi
    if ! jq --exit-status '
      .schemaVersion == 1 and
      (.identities | type == "object") and
      all(.identities | to_entries[];
        (.key | test("^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$")) and
        (.value | type == "array" and length >= 1 and length <= 2) and
        all(.value[]; type == "string" and test("^[0-9a-f]{64}$")))
    ' "$registry" >/dev/null; then
      printf '%s\n' "installed credential registry is invalid: $registry" >&2
      exit 1
    fi
    if jq --exit-status --arg identity "$identity" --arg digest "$actual_digest" \
      '.identities[$identity] // [] | index($digest) != null' "$registry" >/dev/null; then
      chmod 0600 "$registry"
      printf '%s\n' "credential already installed: $kind/$identity"
      exit 0
    fi
    existing_count=$(jq --arg identity "$identity" '.identities[$identity] // [] | length' "$registry")
    if (( existing_count > 0 )) && [[ "$rotate" != true ]]; then
      printf '%s\n' "credential identity already exists; use --rotate: $kind/$identity" >&2
      exit 1
    fi
    if (( existing_count >= 2 )); then
      printf '%s\n' "credential identity already has two active digests; retire one first: $kind/$identity" >&2
      exit 1
    fi
    jq --arg identity "$identity" --arg digest "$actual_digest" \
      '.identities[$identity] = ((.identities[$identity] // []) + [$digest])' \
      "$registry" > "$temporary_registry"
  else
    jq --null-input --arg identity "$identity" --arg digest "$actual_digest" \
      '{schemaVersion: 1, identities: {($identity): [$digest]}}' > "$temporary_registry"
  fi
  chmod 0600 "$temporary_registry"
  mv "$temporary_registry" "$registry"
  trap - EXIT
fi

printf '%s\n' "credential installed: $target/$kind/$identity"
