#!/usr/bin/env bash
set -euo pipefail

script_directory="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=./auth-secret-permissions.sh
source "$script_directory/auth-secret-permissions.sh"
# shellcheck source=./auth-registry.sh
source "$script_directory/auth-registry.sh"

usage() {
  printf '%s\n' 'Usage: install-auth-secret [--root <directory>] [--rotate] <edge|server> <bundle-directory>'
}

root_directory=/
rotate=false
while (( $# > 0 )); do
  case "$1" in
    --help)
      usage
      exit 0
      ;;
    --root)
      if (( $# < 2 )); then
        usage >&2
        exit 2
      fi
      root_directory=$2
      shift 2
      ;;
    --rotate)
      rotate=true
      shift
      ;;
    --*)
      usage >&2
      exit 2
      ;;
    *)
      break
      ;;
  esac
done

if (( $# != 2 )); then
  usage >&2
  exit 2
fi

target=$1
bundle_directory=$2
case "$target" in
  edge|server) ;;
  *)
    printf '%s\n' 'target must be edge or server' >&2
    exit 2
    ;;
esac

root_directory=$(auth_root_directory "$root_directory")
auth_check_path "$bundle_directory"

token_file="$bundle_directory/token"
metadata_file="$bundle_directory/metadata.json"
auth_regular_file "$token_file"
auth_regular_file "$metadata_file"
if [[ ! -f "$token_file" || -L "$token_file" || ! -f "$metadata_file" || -L "$metadata_file" ]]; then
  printf '%s\n' 'credential bundle must contain token and metadata.json' >&2
  exit 1
fi
for private_path in "$bundle_directory" "$token_file" "$metadata_file"; do
  private_mode=$(stat --format='%a' "$private_path")
  if (( (8#$private_mode & 077) != 0 )); then
    printf '%s\n' "credential bundle grants group or other access: $private_path" >&2
    exit 1
  fi
done
if (( $(wc -c < "$token_file") != 64 )) || ! grep -Eq '^[0-9a-f]{64}$' "$token_file"; then
  printf '%s\n' 'credential token has an invalid format' >&2
  exit 1
fi
if ! jq --exit-status '
  .schemaVersion == 1 and
  (.kind == "edge-backend" or .kind == "camera-media" or .kind == "edge-control") and
  (.identity | type == "string" and test("^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$")) and
  (.digest | type == "string" and test("^[0-9a-f]{64}$")) and
  (if .kind == "edge-backend" then
    (.siteId | type == "string" and test("^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$")) and
    (.sensorIds | type == "array" and length == 2 and .[0] != .[1] and
      all(.[]; type == "string" and test("^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$")))
  else true end)
' "$metadata_file" >/dev/null; then
  printf '%s\n' 'credential metadata is invalid' >&2
  exit 1
fi

kind=$(jq --raw-output '.kind' "$metadata_file")
if [[ "$kind" == edge-control && "$target" != edge ]]; then
  printf '%s\n' 'edge-control credentials are installed on the Edge only' >&2
  exit 1
fi
identity=$(jq --raw-output '.identity' "$metadata_file")
expected_digest=$(jq --raw-output '.digest' "$metadata_file")
actual_digest=$(sha256sum "$token_file" | awk '{print $1}')
if [[ "$actual_digest" != "$expected_digest" ]]; then
  printf '%s\n' 'credential token does not match metadata digest' >&2
  exit 1
fi

umask 077
private_gid=$(auth_private_gid "$root_directory")
if [[ "$target" == "edge" ]]; then
  reader_group=$(auth_reader_group edge "$kind")
  reader_gid=$(auth_reader_gid "$root_directory" "$reader_group" true)
  secret_directory="$root_directory/opt/ajin/secrets"
  case "$kind" in
    edge-backend) destination_name=edge-token ;;
    camera-media) destination_name=camera-token ;;
    edge-control) destination_name=calibration-api-token ;;
  esac
  destination="$secret_directory/$destination_name"
  destination_metadata="$secret_directory/$destination_name.metadata.json"
  auth_prepare_directory "$root_directory" "$secret_directory"
  auth_regular_file "$destination"
  auth_regular_file "$destination_metadata"
  auth_lock "$root_directory" "$secret_directory/.auth-secret.lock"

  if [[ -e "$destination" ]]; then
    if [[ -L "$destination" || ! -f "$destination" ]]; then
      printf '%s\n' "installed credential is not a regular file: $destination" >&2
      exit 1
    fi
    installed_digest=$(sha256sum "$destination" | awk '{print $1}')
    if [[ "$installed_digest" == "$actual_digest" ]]; then
      if [[ ! -f "$destination_metadata" ]] || ! jq --exit-status \
        --arg kind "$kind" --arg identity "$identity" --arg digest "$actual_digest" \
        '.schemaVersion == 1 and .kind == $kind and .identity == $identity and .digest == $digest' \
        "$destination_metadata" >/dev/null; then
        if [[ "$rotate" != true ]]; then
          printf '%s\n' "installed credential metadata mismatch; retry with --rotate: $destination_metadata" >&2
          exit 1
        fi
        temporary_metadata=$(mktemp "$secret_directory/.${destination_name}.metadata.XXXXXX")
        trap 'find "$temporary_metadata" -maxdepth 0 -type f -delete' EXIT
        install -m 0600 "$metadata_file" "$temporary_metadata"
        auth_set_permissions "$root_directory" "$temporary_metadata" 600 "$private_gid"
        mv "$temporary_metadata" "$destination_metadata"
        trap - EXIT
      fi
      auth_set_permissions "$root_directory" "$destination" 640 "$reader_gid"
      auth_set_permissions "$root_directory" "$destination_metadata" 600 "$private_gid"
      printf '%s\n' "credential already installed: $kind/$identity"
      exit 0
    elif [[ "$rotate" != true ]]; then
      printf '%s\n' "credential already exists; use --rotate: $destination" >&2
      exit 1
    fi
  fi

  temporary_token=$(mktemp "$secret_directory/.${destination_name}.XXXXXX")
  temporary_metadata=$(mktemp "$secret_directory/.${destination_name}.metadata.XXXXXX")
  cleanup_edge() {
    local temporary_path
    for temporary_path in "$temporary_token" "$temporary_metadata"; do
      if [[ -f "$temporary_path" && ! -L "$temporary_path" ]]; then
        find "$temporary_path" -maxdepth 0 -type f -delete
      fi
    done
  }
  trap cleanup_edge EXIT
  install -m 0600 "$token_file" "$temporary_token"
  install -m 0600 "$metadata_file" "$temporary_metadata"
  auth_set_permissions "$root_directory" "$temporary_token" 640 "$reader_gid"
  auth_set_permissions "$root_directory" "$temporary_metadata" 600 "$private_gid"
  mv "$temporary_token" "$destination"
  mv "$temporary_metadata" "$destination_metadata"
  trap - EXIT
else
  registry="$root_directory/$(auth_registry_relative "$kind")"
  registry_directory=$(dirname "$registry")
  auth_prepare_directory "$root_directory" "$registry_directory"
  auth_regular_file "$registry"

  auth_lock "$root_directory" "$registry_directory/.auth-secret.lock"

  site_id=$(jq --raw-output '.siteId // ""' "$metadata_file")
  sensor_ids=$(jq --compact-output '.sensorIds // []' "$metadata_file")
  token=$(<"$token_file")
  if [[ -f "$registry" ]]; then
    if [[ -L "$registry" ]]; then
      printf '%s\n' "installed token file is a symbolic link: $registry" >&2
      exit 1
    fi
    auth_validate_permissions "$root_directory" "$registry" 600 "$private_gid"
    current=$(auth_registry_read "$kind" "$registry")
  elif [[ "$kind" == edge-backend ]]; then
    current='[]'
  else
    current='{}'
  fi

  case "$kind" in
    edge-backend)
      if jq --exit-status --arg token "$token" 'any(.[]; .token == $token)' <<< "$current" >/dev/null; then
        printf '%s\n' "credential already installed: $kind/$identity"
        exit 0
      fi
      existing_count=$(jq --arg identity "$identity" '[.[] | select(.edge_id == $identity)] | length' <<< "$current")
      if (( existing_count > 0 )) && [[ "$rotate" != true ]]; then
        printf '%s\n' "credential identity already exists; use --rotate: $kind/$identity" >&2
        exit 1
      fi
      if (( existing_count >= 2 )); then
        printf '%s\n' "credential identity already has two active tokens; retire one first: $kind/$identity" >&2
        exit 1
      fi
      if (( existing_count > 0 )) && ! jq --exit-status \
        --arg identity "$identity" --arg site "$site_id" --argjson sensors "$sensor_ids" \
        'all(.[] | select(.edge_id == $identity); .site_id == $site and .sensor_ids == $sensors)' \
        <<< "$current" >/dev/null; then
        printf '%s\n' "rotation must keep the site and sensor IDs: $kind/$identity" >&2
        exit 1
      fi
      updated=$(jq --compact-output --arg identity "$identity" --arg site "$site_id" \
        --argjson sensors "$sensor_ids" --arg token "$token" \
        '. + [{site_id: $site, edge_id: $identity, sensor_ids: $sensors, token: $token}]' <<< "$current")
      ;;
    camera-media)
      installed=$(jq --raw-output --arg identity "$identity" '.[$identity] // ""' <<< "$current")
      if [[ "$installed" == "$token" ]]; then
        printf '%s\n' "credential already installed: $kind/$identity"
        exit 0
      fi
      if [[ -n "$installed" && "$rotate" != true ]]; then
        printf '%s\n' "credential identity already exists; use --rotate: $kind/$identity" >&2
        exit 1
      fi
      # Camera Media Service accepts one token per camera, so rotation has no overlap.
      updated=$(jq --compact-output --arg identity "$identity" --arg token "$token" \
        '.[$identity] = $token' <<< "$current")
      ;;
  esac
  auth_registry_write "$root_directory" "$kind" "$updated" "$registry"
fi

printf '%s\n' "credential installed: $target/$kind/$identity"
