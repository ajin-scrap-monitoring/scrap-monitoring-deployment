#!/usr/bin/env bash
set -euo pipefail

usage() {
  printf '%s\n' 'Usage: validate-auth-secrets [--root <directory>] <edge|server> [environment-file]'
}

root_directory=/
if [[ "${1:-}" == "--help" ]]; then
  usage
  exit 0
fi
if [[ "${1:-}" == "--root" ]]; then
  if (( $# < 3 )); then
    usage >&2
    exit 2
  fi
  root_directory=$2
  shift 2
fi
if (( $# < 1 || $# > 2 )); then
  usage >&2
  exit 2
fi

target=$1
environment_file=${2:-}
case "$target" in
  edge|server) ;;
  *)
    printf '%s\n' 'target must be edge or server' >&2
    exit 2
    ;;
esac

validate_private_mode() {
  local path=$1
  local mode
  mode=$(stat --format='%a' "$path")
  if (( (8#$mode & 077) != 0 )); then
    printf '%s\n' "secret file grants group or other access: $path" >&2
    return 1
  fi
}

validate_private_owner() {
  local path=$1
  local owner
  if [[ "$root_directory" != "/" ]]; then
    return
  fi
  owner=$(stat --format='%u' "$path")
  if (( owner != 0 )); then
    printf '%s\n' "secret path is not owned by root: $path" >&2
    return 1
  fi
}

validate_secret_path() {
  local path=$1
  validate_private_mode "$path"
  validate_private_owner "$path"
}

validate_edge_secret() {
  local name=$1
  local expected_kind=$2
  local expected_identity=$3
  local token="$root_directory/opt/ajin/secrets/$name"
  local metadata="$token.metadata.json"
  local secret_directory
  secret_directory=$(dirname "$token")

  if [[ ! -f "$token" || -L "$token" || ! -f "$metadata" || -L "$metadata" ]]; then
    printf '%s\n' "required Edge credential is missing: $name" >&2
    return 1
  fi
  validate_secret_path "$secret_directory"
  validate_secret_path "$token"
  validate_secret_path "$metadata"
  if (( $(wc -c < "$token") != 64 )) || ! grep -Eq '^[0-9a-f]{64}$' "$token"; then
    printf '%s\n' "Edge credential has an invalid format: $name" >&2
    return 1
  fi

  local actual_digest
  actual_digest=$(sha256sum "$token" | awk '{print $1}')
  if ! jq --exit-status \
    --arg kind "$expected_kind" \
    --arg identity "$expected_identity" \
    --arg digest "$actual_digest" \
    '.schemaVersion == 1 and .kind == $kind and .identity == $identity and .digest == $digest' \
    "$metadata" >/dev/null; then
    printf '%s\n' "Edge credential metadata mismatch: $name" >&2
    return 1
  fi
}

validate_registry() {
  local path=$1
  local registry_directory
  registry_directory=$(dirname "$path")
  if [[ ! -f "$path" || -L "$path" ]]; then
    printf '%s\n' "required Server credential registry is missing: $path" >&2
    return 1
  fi
  validate_secret_path "$registry_directory"
  validate_secret_path "$path"
  if ! jq --exit-status '
    .schemaVersion == 1 and
    (.identities | type == "object") and
    (.identities | length > 0) and
    all(.identities | to_entries[];
      (.key | test("^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$")) and
      (.value | type == "array" and length >= 1 and length <= 2) and
      all(.value[]; type == "string" and test("^[0-9a-f]{64}$")))
  ' "$path" >/dev/null; then
    printf '%s\n' "Server credential registry is invalid: $path" >&2
    return 1
  fi
}

if [[ "$target" == "edge" ]]; then
  if [[ -z "$environment_file" || ! -f "$environment_file" ]]; then
    printf '%s\n' 'Edge validation requires an environment file' >&2
    exit 2
  fi
  edge_id=$(awk -F= '$1 == "EDGE_ID" {print substr($0, index($0, "=") + 1)}' "$environment_file")
  camera_id=$(awk -F= '$1 == "CAMERA_ID" {print substr($0, index($0, "=") + 1)}' "$environment_file")
  if [[ -z "$edge_id" || -z "$camera_id" ]]; then
    printf '%s\n' 'Edge environment must define EDGE_ID and CAMERA_ID' >&2
    exit 1
  fi
  validate_edge_secret edge-token edge-backend "$edge_id"
  validate_edge_secret camera-token camera-media "$camera_id"
else
  if [[ -n "$environment_file" ]]; then
    printf '%s\n' 'Server validation does not accept an environment file' >&2
    exit 2
  fi
  validate_registry "$root_directory/srv/scrap-monitoring/secrets/backend/edge-token-digests.json"
  validate_registry "$root_directory/srv/scrap-monitoring/secrets/media/camera-token-digests.json"
fi

printf '%s\n' "authentication secrets valid: $target"
