#!/usr/bin/env bash
set -euo pipefail

repository="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "${repository}"

node_modules/.bin/markdownlint-cli2 "**/*.md"
npm audit --audit-level=high
.venv/bin/yamllint .github/workflows .yamllint.yml targets
find release pki/config -type f -name '*.json' -print0 \
  | xargs -0 jq empty
jq empty package.json package-lock.json
.venv/bin/ruff check \
  delivery/offline/bundle_importer.py \
  delivery/release_applier.py \
  delivery/release_verifier.py \
  release/build-assets \
  release/release_manifest.py \
  release/target_validation.py \
  release/validate-manifest \
  release/validate-targets \
  release/verify-assets \
  tests
.venv/bin/ruff format --check \
  delivery/offline/bundle_importer.py \
  delivery/release_applier.py \
  delivery/release_verifier.py \
  release/build-assets \
  release/release_manifest.py \
  release/target_validation.py \
  release/validate-manifest \
  release/validate-targets \
  release/verify-assets \
  tests
go -C tools mod verify
go -C tools tool actionlint "${repository}"/.github/workflows/*.yml
docker compose -f targets/edge/compose.yaml config --quiet
docker compose -f targets/server/compose.yaml config --quiet
shellcheck \
  delivery/apply-release \
  delivery/generate-auth-secret \
  delivery/install-auth-secret \
  delivery/retire-auth-secret \
  delivery/validate-auth-secrets \
  delivery/validate-environment \
  delivery/verify-release \
  delivery/online/fetch-release \
  delivery/offline/import-bundle \
  pki/validate-ca-state \
  pki/ensure-server-certificate \
  pki/verify-server-certificate \
  release/pull-images \
  tools/install-validation \
  tests/validate-test-host \
  tests/validate-repository
systemd-analyze verify \
  tests/systemd/fixtures/docker.service \
  targets/edge/systemd/*.service \
  targets/server/systemd/*.service \
  pki/systemd/*.service \
  pki/systemd/*.timer
.venv/bin/python -m unittest discover --start-directory tests --pattern 'test_*.py'
empty_tree="$(git hash-object -t tree /dev/null)"
git diff --check "${empty_tree}" HEAD
git diff --check
git diff --cached --check
